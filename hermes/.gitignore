# Ignore cache and temporary files
profiles/**/cache/
profiles/**/.cache/
profiles/**/.hub/
profiles/**/image_cache/
profiles/**/audio_cache/
profiles/**/home/
profiles/**/logs/
profiles/**/bin/
profiles/**/lsp/
profiles/**/sessions/
profiles/**/state/
profiles/**/workspace/
profiles/**/hooks/

# Ignore database files
profiles/**/*.db
profiles/**/*.db-shm
profiles/**/*.db-wal

# Ignore auth and runtime files
profiles/**/auth.*
